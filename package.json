{
  "name": "@yiminlab/voyage",
  "version": "0.1.0",
  "description": "YiminLab 统一样式系统: 四轴 token 矩阵 (theme x mode x style x tone) + quarry 规格组件层",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tokens.css",
    "voyage.css",
    "index.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./voyage.css": "./voyage.css",
    "./index.css": "./index.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wangggym/yiminlab.git",
    "directory": "packages/voyage"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
